  "scenarios": [
    {
      "id": "B01",
      "expectation": "Retry is bound to synthetic subject, original message, source revision, issue revision and attempt; wrong binding leaves state unchanged."
    },
    {
      "id": "B02",
      "expectation": "Retry re-evaluates exactly the original text. Success resolves only its technical issue; current complaint creates/retains a health issue."
    },
    {
      "id": "B03",
      "expectation": "Duplicate identical event id is idempotent, different payload under same id is rejected."
    },
    {
      "id": "B04",
      "expectation": "A superseded retry result cannot settle the latest attempt; a newer complaint elsewhere survives an older valid retry."
    },
    {
      "id": "B05",
      "expectation": "Clarification requires an explicit original-meaning phrase plus a fresh text assessment. A bare R0, approval flag or ordinary new message cannot settle an issue."
    },
    {
      "id": "B06",
      "expectation": "Clarification in NL/EN/DE can settle a language misunderstanding, but cannot settle an existing health report."
    },
    {
      "id": "B07",
      "expectation": "A health complaint inside clarification produces a health record. Other issues and history remain."
    },
    {
      "id": "B08",
      "expectation": "Self-report via confirmation or affirmative chat is exact-revision and target-bound, not clearance. Conflicting new complaint rejects recovery and is recorded."
    },
    {
      "id": "B09",
      "expectation": "New conversation, elapsed time, unknown deletion event and user approved fields do not release health records."
    },
    {
      "id": "C01",
      "expectation": "Daily example: one workout, 35 min and 6000 steps; comparable prior day 30 min gives +5 min, no training advice."
    },
    {
      "id": "C02",
      "expectation": "Post-workout example: 35 min, 12 sets, 96 reps; same-method prior 10 sets gives +2 sets. No intensity or readiness judgement."
    },
    {
      "id": "C03",
      "expectation": "Weekly example: 3 workouts, 105 min vs 90 min over equal complete 7-day windows gives +15 min."
    },
    {
      "id": "C04",
      "expectation": "Partial coverage, unequal windows, changed methods, mismatched units, absent values and zero comparator never fabricate comparisons or fill zero."
    },
    {
      "id": "C05",
      "expectation": "Foreign subject or source, absent consent/entitlement and extra advice/action fields cannot expose or augment facts."
    },
    {
      "id": "C06",
      "expectation": "Chat/history/facts/observations are separate from recommendations/actions. The same bounded template remains available before/after recovery under existing authority."
    },
    {
      "id": "D01",
      "expectation": "New serious provisional R3/R4, unclassified and repeated same-code reports increment revisions without inventing severity or medical recurrence thresholds."
    },
    {
      "id": "D02",
      "expectation": "Self-report preserves original evidence and last report revision. A repeated/new signal is current again; prior report is not current recovery."
    },
    {
      "id": "D03",
      "expectation": "Concrete open serious/unclassified/recurrence criteria are displayed alongside remaining accessible content; no human queue or automatic release."
    },
    {
      "id": "E01",
      "expectation": "Synthetic 30/90/180-day boundaries are exact and purpose/necessity-specific; closure anchors details, creation anchors counters/audit."
    },
    {
      "id": "E02",
      "expectation": "Unresolved storage has no default deadline or retain-forever choice; persistence disabled, owner maximum/responsibility unresolved."
    },
    {
      "id": "E03",
      "expectation": "Missing/expired details yield missing_context_not_clearance, never fabricate health clearance or mutate entitlements."
    },
    {
      "id": "E04",
      "expectation": "Unnecessary data is not proposed for retention; caps cannot be increased. No actual cleanup, timers or real data."
    },
    {
      "id": "I01",
      "expectation": "All 23 phase6e0 files and all frozen app sources byte-identical. No app/bundler/scheduler reference, dependency, network or persistence."
    },
    {
      "id": "I02",
      "expectation": "Pure Node-only modules run under an allowlisted in-memory loader without network, clock, environment, storage or external provider."
    },
    {
      "id": "I03",
      "expectation": "Warnings copy and provisional R1-R4 mappings are reused unchanged; annotations/expected fixture labels rejected as classifier input."
    }
  ]
}
